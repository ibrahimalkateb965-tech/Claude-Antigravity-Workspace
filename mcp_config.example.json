{
  "mcpServers": {
    "GlobalMemorySync": {
      "command": "python",
      "args": [
        "C:/Users/Kt/.gemini/config/plugins/global-memory-sync/mcp_global_memory_server.py"
      ]
    },
    "construction-engineering-suite": {
      "command": "python",
      "args": [
        "plugins/construction-engineering-suite/mcp/server.py"
      ],
      "disabledTools": []
    },
    "hostinger": {
      "command": "npx",
      "args": [
        "-y",
        "hostinger-api-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "YOUR_HOSTINGER_API_TOKEN_HERE"
      }
    },
    "google-ads": {
      "command": "python",
      "args": [
        "tools/google_ads_mcp/server.py"
      ],
      "disabledTools": []
    },
    "github-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE"
      }
    }
  }
}